
profiles {
    
    gemini {
        params {
            boltz_cache = "/tgen_labs/altin/boltz/.boltz"
        }

        process {

            withLabel: boltz_local {
                executor = 'local'
                conda = "/tgen_labs/altin/miniconda3/envs/boltz"
            }

            withLabel: boltz_gpu {
                queue = 'gpu-a100'
                cpus ='8'
                clusterOptions = '--nodes=1 --ntasks=1 --gres=gpu:1 --time=3:00:00'
                memory = '64GB'
                executor = "slurm"

                errorStrategy = "retry"
                maxRetries = 1
                conda = "/tgen_labs/altin/miniconda3/envs/boltz"
            }
            withLabel: boltz_cpu {
                queue = 'compute'
                cpus ='8'
                clusterOptions = '--nodes=1 --ntasks=1 --time=12:00:00'
                memory = '180GB'
                executor = "slurm"

                // errorStrategy = "retry"
                // maxRetries = 1
                conda = "/tgen_labs/altin/miniconda3/envs/boltz"
            }
        }
    }
}