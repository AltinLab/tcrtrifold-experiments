
profiles {
    
    gemini {
        params {
            boltz_cache = "/tgen_labs/altin/boltz/.boltz"
        }

        process {

            withLabel: boltz_local {
                executor = 'local'
                conda = "envs/boltz.yaml"
            }

            withLabel: boltz_gpu {
                queue = { task.attempt == 1 ? 'gpu-v100' : 'gpu-a100' }
                cpus ='8'
                clusterOptions = '--nodes=1 --ntasks=1 --gres=gpu:1 --time=3:00:00'
                memory = '64GB'
                executor = "slurm"

                errorStrategy = "retry"
                maxRetries = 1
                conda = "envs/boltz.yaml"
            }
        }
    }
}